# Dirección pública de la versión web. Los enlaces de reto apuntan aquí.
# Versión web publicada con GitHub Pages en el dominio de Kalli Labs.
VITE_PUBLIC_URL=https://kallilabs.com/apilalo/

# Enlace a tu ficha de Google Play, cuando exista. La versión web mostrará "Descárgalo en Google Play".
# VITE_PLAY_URL=https://play.google.com/store/apps/details?id=com.kallilabs.apilalo
VITE_PLAY_URL=

# Permite escribir el nombre en el reto. Apagado porque la app va dirigida también a menores de 13
# (política de Familias de Google Play): así la app no pide ningún dato.
VITE_ALLOW_PLAYER_NAME=false
